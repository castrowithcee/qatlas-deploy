{
  "package": ".",
  "versionVariable": "github.com/castrowithcee/qatlas-deploy/internal/cli.version",
  "targets": ["linux/amd64", "linux/arm64"],
  "manpageCommand": ["go", "run", ".", "manpage", "--dir", "{dir}"],
